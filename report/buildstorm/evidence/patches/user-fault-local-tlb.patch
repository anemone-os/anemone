+#[cfg(feature = "kunit")]
+mod kunits {
+    use super::*;
+
+    fn mapped(ppn: u64, flags: PteFlags) -> Translated {
+        Translated {
+            ppn: PhysPageNum::new(ppn),
+            flags,
+        }
+    }
+
+    #[kunit]
+    fn pte_transition_distinguishes_additive_and_destructive_changes() {
+        let read = PteFlags::READ | PteFlags::USER;
+        let write = read | PteFlags::WRITE;
+
+        assert_eq!(
+            classify_pte_transition(None, PhysPageNum::new(1), read),
+            PteTransition::Added
+        );
+        assert_eq!(
+            classify_pte_transition(Some(mapped(1, read)), PhysPageNum::new(1), read),
+            PteTransition::Unchanged
+        );
+        assert_eq!(
+            classify_pte_transition(Some(mapped(1, read)), PhysPageNum::new(1), write),
+            PteTransition::Relaxed
+        );
+        assert_eq!(
+            classify_pte_transition(Some(mapped(1, write)), PhysPageNum::new(1), read),
+            PteTransition::ReplacedOrRestricted
+        );
+        assert_eq!(
+            classify_pte_transition(Some(mapped(1, read)), PhysPageNum::new(2), read),
+            PteTransition::ReplacedOrRestricted
+        );
+    }
+
+    #[kunit]
+    fn only_rv64_actual_additions_defer_local_completion() {
+        assert_eq!(
+            defer_local_fence(PageAccessKind::ActualFault, PteTransition::Added),
+            cfg!(target_arch = "riscv64")
+        );
+        assert!(!defer_local_fence(
+            PageAccessKind::Immediate,
+            PteTransition::Added
+        ));
+        assert!(!defer_local_fence(
+            PageAccessKind::ActualFault,
+            PteTransition::Unchanged
+        ));
+        assert!(!defer_local_fence(
+            PageAccessKind::ActualFault,
+            PteTransition::Relaxed
+        ));
+        assert!(!defer_local_fence(
+            PageAccessKind::ActualFault,
+            PteTransition::ReplacedOrRestricted
+        ));
+    }
+}
