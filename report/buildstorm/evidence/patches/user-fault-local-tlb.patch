+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum PteTransition {
+    Added,
+    Unchanged,
+    Relaxed,
+    ReplacedOrRestricted,
+}
+
+fn classify_pte_transition(
+    previous: Option<Translated>,
+    ppn: PhysPageNum,
+    flags: PteFlags,
+) -> PteTransition {
+    let Some(previous) = previous else {
+        return PteTransition::Added;
+    };
+    if previous.ppn == ppn && previous.flags == flags {
+        PteTransition::Unchanged
+    } else if previous.ppn == ppn && flags.contains(previous.flags) {
+        PteTransition::Relaxed
+    } else {
+        PteTransition::ReplacedOrRestricted
+    }
+}
+
+fn defer_local_fence(kind: PageAccessKind, transition: PteTransition) -> bool {
+    cfg!(target_arch = "riscv64")
+        && kind == PageAccessKind::ActualFault
+        && transition == PteTransition::Added
+}
