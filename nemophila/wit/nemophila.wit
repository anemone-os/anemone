package anemone:nemophila@0.1.0;

// This file is the logical interface truth. The Rust SDK consumes it through
// wit-bindgen; kernel Host adapters are deliberately small handwritten
// consumers because the in-tree interpreter exposes Core Wasm linking rather
// than a component Host generator. Any interface change must update those
// adapters and their real link/call tests in the same reviewed change. Do not
// add a copied schema, hash or runtime metadata policy as another truth.

/// Point-specific clone observer registration.
interface weave-clone {
    /// The result of asking the Host to bind this instance to the clone point.
    enum registration-result {
        registered,
        provider-unavailable,
        already-registered,
    }

    /// The module has already stored its typed callback before this call.
    register-observer: func() -> registration-result;
}

/// Point-specific user-thread exit-begin observation registration.
interface weave-thread-exit {
    /// The result of asking the Host to bind this instance to the thread-exit
    /// point.
    enum registration-result {
        registered,
        provider-unavailable,
        already-registered,
    }

    /// The module has already stored its typed callback before this call.
    register-observer: func() -> registration-result;
}

/// Value-only diagnostic submission to the kernel logging owner.
interface logging {
    /// Existing variants retain their canonical ABI ordinals. The remaining
    /// kernel severities are appended so older module artifacts keep the same
    /// four discriminants.
    enum level {
        debug,
        info,
        warning,
        error,
        emergency,
        alert,
        critical,
        notice,
    }

    /// Submit one structured record to the kernel logging owner.
    write: func(level: level, message: string);

    /// Emit one raw console-only fragment using kernel `kprint` semantics.
    print: func(message: string);

    /// Emit one raw console-only line using kernel `kprintln` semantics.
    println: func(message: string);
}

/// A module with no callback export. It can decline load or use value-only
/// Host services without fabricating an extension-point callback.
world lifecycle-module {
    import logging;

    export load: func() -> result;
}

/// The single-point clone observer module shape.
world clone-module {
    import weave-clone;
    import logging;

    /// The only module lifecycle entry in the R0 artifact envelope.
    /// Its result reports only whether module initialization succeeded; binding
    /// state remains owned by the point-specific registration import.
    export load: func() -> result;

    /// The fixed trampoline for the task-owned clone observer point.
    export observe-clone: func(creator-tid: u32, child-tid: u32);
}

/// A module observing task creation and user-thread exit through two
/// independently registered points.
world task-lifecycle-module {
    import weave-clone;
    import weave-thread-exit;
    import logging;

    export load: func() -> result;
    export observe-clone: func(creator-tid: u32, child-tid: u32);

    /// `signaled` selects the meaning of `value`: false carries an eight-bit
    /// normal exit status widened to u32; true carries a signal number.
    export observe-thread-exit: func(tid: u32, signaled: bool, value: u32);
}
